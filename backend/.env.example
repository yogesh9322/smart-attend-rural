# Server Environment Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/smartattend
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Client / Frontend URL Configuration (Used for password reset links & email action buttons)
CLIENT_URL=https://your-frontend.vercel.app

# Production Email Delivery via Resend (HTTPS REST API)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=notifications@your-verified-domain.com
FROM_NAME=SmartAttend Rural

# Cloudinary Storage Configurations (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Twilio SMS Configuration (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Firebase Cloud Messaging Configurations (Optional)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----\n"
